---
import CatalogDisclosure from '../affiliate/CatalogDisclosure.astro';
import { type Lang, getTranslation } from '@i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslation(lang);

const placeholderText = lang === 'es' ? 'Buscar productos...' : 'Search products...';
const noResultsText = lang === 'es' ? 'No se encontraron resultados' : 'No results found';
const searchingText = lang === 'es' ? 'Buscando...' : 'Searching...';
---

<div
  id="search-modal"
  class="search-modal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="search-modal-title"
>
  <div class="search-backdrop"></div>
  <div class="search-container">
    <div class="search-header">
      <h2 id="search-modal-title" class="sr-only">
        {lang === 'es' ? 'Buscar productos' : 'Search products'}
      </h2>
      <div class="search-input-wrapper">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path d="M21 21l-4.35-4.35" />
        </svg>
        <label for="search-input" class="sr-only">
          {lang === 'es' ? 'Buscar productos' : 'Search products'}
        </label>
        <input
          type="search"
          id="search-input"
          class="search-input"
          placeholder={placeholderText}
          autocomplete="off"
          autofocus
          aria-describedby="search-status"
        />
        <button
          type="button"
          id="search-close"
          class="search-close"
          aria-label={lang === 'es' ? 'Cerrar búsqueda' : 'Close search'}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Live region for screen reader announcements -->
    <div
      id="search-status"
      class="sr-only"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></div>

    <div id="search-results" class="search-results" role="region" aria-label={lang === 'es' ? 'Resultados de búsqueda' : 'Search results'}>
      <CatalogDisclosure lang={lang} />
      <div class="search-empty" id="search-empty">
        <p>{lang === 'es' ? 'Escribe para buscar productos o pega un link de Amazon' : 'Type to search products or paste an Amazon link'}</p>
      </div>
      <div class="search-loading hidden" id="search-loading" aria-hidden="true">
        <div class="spinner" aria-hidden="true"></div>
        <p>{searchingText}</p>
      </div>
      <div class="search-no-results hidden" id="search-no-results">
        <p>{noResultsText}</p>
      </div>
      <div id="search-results-list" class="search-results-list" role="list"></div>
    </div>
  </div>
</div>

<style>
  /* Neo-Brutalist Search Modal */
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
    opacity: 0;
    visibility: hidden;
    transition: opacity 150ms, visibility 150ms;
  }

  .search-modal[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }

  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(26, 26, 26, 0.8);
  }

  .search-container {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin: 0 1rem;
    background: var(--color-cream, #FFFEF9);
    border: 4px solid var(--color-brutal-black, #1A1A1A);
    box-shadow: 12px 12px 0 var(--color-brutal-black, #1A1A1A);
    overflow: hidden;
    transform: translateY(-20px) rotate(-1deg);
    transition: transform 200ms cubic-bezier(0.68, -0.6, 0.32, 1.6);
  }

  .search-modal[aria-hidden="false"] .search-container {
    transform: translateY(0) rotate(0deg);
  }

  .search-header {
    padding: 1rem 1.25rem;
    border-bottom: 3px solid var(--color-brutal-black, #1A1A1A);
    background: var(--color-brutal-yellow, #FFE14D);
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .search-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-brutal-black, #1A1A1A);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    border: none;
    outline: none;
    font-family: var(--font-display, 'Space Grotesk', sans-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-brutal-black, #1A1A1A);
    background: transparent;
  }

  .search-input::placeholder {
    color: var(--color-brutal-black, #1A1A1A);
    opacity: 0.5;
  }

  .search-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--color-cream, #FFFEF9);
    border: 3px solid var(--color-brutal-black, #1A1A1A);
    color: var(--color-brutal-black, #1A1A1A);
    cursor: pointer;
    box-shadow: 3px 3px 0 var(--color-brutal-black, #1A1A1A);
    transition: all 150ms cubic-bezier(0.68, -0.6, 0.32, 1.6);
    flex-shrink: 0;
  }

  .search-close:hover {
    background: var(--color-brutal-orange, #FF6B35);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--color-brutal-black, #1A1A1A);
  }

  .search-close:active {
    transform: translate(1px, 1px);
    box-shadow: 2px 2px 0 var(--color-brutal-black, #1A1A1A);
  }

  .search-close:focus-visible {
    outline: 3px solid var(--color-brutal-orange, #FF6B35);
    outline-offset: 2px;
  }

  .search-close svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .search-results {
    max-height: 60vh;
    overflow-y: auto;
    background: var(--color-cream, #FFFEF9);
  }

  .search-empty,
  .search-loading,
  .search-no-results {
    padding: 3rem 2rem;
    text-align: center;
    font-family: var(--font-display, 'Space Grotesk', sans-serif);
    font-weight: 600;
    color: var(--color-brutal-black, #1A1A1A);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .search-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .spinner {
    width: 2rem;
    height: 2rem;
    border: 3px solid var(--color-brutal-black, #1A1A1A);
    border-top-color: var(--color-brutal-yellow, #FFE14D);
    animation: spin 0.6s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .hidden {
    display: none !important;
  }

  .search-results-list {
    padding: 0.75rem;
  }

  .search-results-list:empty {
    display: none;
  }

  /* Amazon Link Generator Styles */
  .amazon-link-result {
    padding: 1.5rem;
    background: var(--color-brutal-yellow, #FFE14D);
    border-bottom: 3px solid var(--color-brutal-black, #1A1A1A);
  }

  .amazon-link-result.hidden {
    display: none;
  }

  .amazon-link-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .amazon-link-header svg {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-brutal-orange, #FF6B35);
  }

  .amazon-link-header h3 {
    font-family: var(--font-display, 'Space Grotesk', sans-serif);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0;
  }

  .amazon-link-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .amazon-link-label {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0.7;
  }

  .amazon-link-asin {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.875rem;
    font-weight: 700;
    background: var(--color-brutal-black, #1A1A1A);
    color: var(--color-brutal-yellow, #FFE14D);
    padding: 0.25rem 0.5rem;
  }

  .amazon-link-box {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .amazon-link-input {
    flex: 1;
    padding: 0.75rem 1rem;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    background: var(--color-cream, #FFFEF9);
    border: 2px solid var(--color-brutal-black, #1A1A1A);
    box-shadow: 3px 3px 0 var(--color-brutal-black, #1A1A1A);
    outline: none;
  }

  .amazon-link-copy {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--color-brutal-black, #1A1A1A);
    color: var(--color-cream, #FFFEF9);
    border: 2px solid var(--color-brutal-black, #1A1A1A);
    font-family: var(--font-display, 'Space Grotesk', sans-serif);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 3px 3px 0 var(--color-brutal-black, #1A1A1A);
    transition: all 150ms cubic-bezier(0.68, -0.6, 0.32, 1.6);
  }

  .amazon-link-copy:hover {
    background: var(--color-brutal-orange, #FF6B35);
    color: var(--color-brutal-black, #1A1A1A);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--color-brutal-black, #1A1A1A);
  }

  .amazon-link-copy svg {
    width: 1rem;
    height: 1rem;
  }

  .amazon-link-copy[data-copied="true"] {
    background: #22c55e;
  }

  .amazon-link-actions {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .amazon-link-open,
  .amazon-link-cart {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    font-family: var(--font-display, 'Space Grotesk', sans-serif);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    border: 2px solid var(--color-brutal-black, #1A1A1A);
    box-shadow: 3px 3px 0 var(--color-brutal-black, #1A1A1A);
    transition: all 150ms cubic-bezier(0.68, -0.6, 0.32, 1.6);
  }

  .amazon-link-open {
    background: var(--color-brutal-orange, #FF6B35);
    color: var(--color-brutal-black, #1A1A1A);
    text-decoration: none;
  }

  .amazon-link-open:hover {
    background: var(--color-brutal-black, #1A1A1A);
    color: var(--color-brutal-orange, #FF6B35);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--color-brutal-black, #1A1A1A);
  }

  .amazon-link-cart {
    background: var(--color-cream, #FFFEF9);
    color: var(--color-brutal-black, #1A1A1A);
  }

  .amazon-link-cart:hover {
    background: var(--color-brutal-yellow, #FFE14D);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--color-brutal-black, #1A1A1A);
  }

  .amazon-link-open svg,
  .amazon-link-cart svg {
    width: 1rem;
    height: 1rem;
  }

  .amazon-link-disclaimer {
    font-size: 0.6875rem;
    color: var(--color-brutal-black, #1A1A1A);
    opacity: 0.6;
    margin: 0;
    text-align: center;
  }

  /* Result item styles - will be added dynamically */
  :global(.search-result-item) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 2px solid transparent;
    margin-bottom: 0.5rem;
    transition: all 150ms cubic-bezier(0.68, -0.6, 0.32, 1.6);
  }

  :global(.search-result-item > .amazon-price-details),
  :global(.search-result-item > .amazon-price-time) { flex-basis: 100%; }

  :global(.search-result-item:hover) {
    background: var(--color-brutal-yellow, #FFE14D);
    border-color: var(--color-brutal-black, #1A1A1A);
    box-shadow: 4px 4px 0 var(--color-brutal-black, #1A1A1A);
    transform: translate(-2px, -2px);
  }

  :global(.search-result-link) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
    min-width: 0;
    text-decoration: none;
    padding: 0.25rem;
  }

  :global(.search-result-image) {
    width: 3rem;
    height: 3rem;
    background: var(--color-white, #FFFFFF);
    border: 2px solid var(--color-brutal-black, #1A1A1A);
    object-fit: contain;
    padding: 0.15rem;
    flex-shrink: 0;
  }

  :global(.search-result-content) {
    flex: 1;
    min-width: 0;
  }

  :global(.search-result-brand) {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.5625rem;
    font-weight: 700;
    color: var(--color-brutal-black, #1A1A1A);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.search-result-title) {
    font-family: var(--font-display, 'Space Grotesk', sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-brutal-black, #1A1A1A);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.search-result-price) {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-brutal-black, #1A1A1A);
    background: var(--color-brutal-yellow, #FFE14D);
    padding: 0.2rem 0.4rem;
    border: 2px solid var(--color-brutal-black, #1A1A1A);
    flex-shrink: 0;
  }

  /* Cart button in search results */
  :global(.search-result-cart-btn) {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-cream, #FFFEF9);
    border: 2px solid var(--color-brutal-black, #1A1A1A);
    color: var(--color-brutal-black, #1A1A1A);
    cursor: pointer;
    box-shadow: 2px 2px 0 var(--color-brutal-black, #1A1A1A);
    transition: all 150ms cubic-bezier(0.68, -0.6, 0.32, 1.6);
    flex-shrink: 0;
  }

  :global(.search-result-cart-btn svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  :global(.search-result-cart-btn .cart-plus) {
    position: absolute;
    top: -4px;
    right: -4px;
    width: 14px;
    height: 14px;
    background: var(--color-brutal-orange, #FF6B35);
    border: 1.5px solid var(--color-brutal-black, #1A1A1A);
    border-radius: 50%;
    font-size: 0.6rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  :global(.search-result-cart-btn:hover) {
    background: var(--color-brutal-orange, #FF6B35);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--color-brutal-black, #1A1A1A);
  }

  :global(.search-result-cart-btn:active) {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 var(--color-brutal-black, #1A1A1A);
  }

  :global(.search-result-cart-btn.added) {
    background: #22c55e;
    color: white;
  }

  :global(.search-result-cart-btn.added .cart-plus) {
    content: '✓';
  }

  :global(.search-result-cart-btn.added .cart-plus::before) {
    content: '✓';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.search-result-cart-btn.added .cart-plus) {
    background: #22c55e;
    color: transparent;
  }
</style>

<script>
  import { escapeHtml, safeCatalogUrl, formatCatalogPrice, readCatalogResponse, catalogUnavailableMessage } from '../../lib/catalog-ui.mjs';
  import { priceDetailsHtml } from '../../lib/amazon-notices.mjs';

  let searchController: AbortController | null = null;
  let searchVersion = 0;
  let currentLang = document.documentElement.lang || 'es';
  let previousActiveElement: HTMLElement | null = null;

  const modal = document.getElementById('search-modal');
  const triggerDesktop = document.getElementById('search-trigger-desktop');
  const triggerMobile = document.getElementById('search-trigger-mobile');
  const closeBtn = document.getElementById('search-close');
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsContainer = document.getElementById('search-results-list');
  const emptyState = document.getElementById('search-empty');
  const loadingState = document.getElementById('search-loading');
  const noResultsState = document.getElementById('search-no-results');
  const statusRegion = document.getElementById('search-status');
  const searchContainer = modal?.querySelector('.search-container');

  // Announce to screen readers
  function announce(message: string) {
    if (statusRegion) {
      statusRegion.textContent = message;
    }
  }

  // Get focusable elements within container
  function getFocusableElements(container: Element): HTMLElement[] {
    const selector = 'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';
    return Array.from(container.querySelectorAll(selector)) as HTMLElement[];
  }

  // Focus trap handler
  function handleFocusTrap(e: KeyboardEvent) {
    if (e.key !== 'Tab' || !searchContainer) return;

    const focusable = getFocusableElements(searchContainer);
    if (focusable.length === 0) return;

    const firstFocusable = focusable[0];
    const lastFocusable = focusable[focusable.length - 1];

    if (e.shiftKey) {
      if (document.activeElement === firstFocusable) {
        e.preventDefault();
        lastFocusable.focus();
      }
    } else {
      if (document.activeElement === lastFocusable) {
        e.preventDefault();
        firstFocusable.focus();
      }
    }
  }

  function openModal() {
    // Store reference to element that triggered the modal
    previousActiveElement = document.activeElement as HTMLElement;

    modal?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    // Add focus trap listener
    document.addEventListener('keydown', handleFocusTrap);

    // Focus the input after a brief delay for animation
    setTimeout(() => input?.focus(), 100);


  }

  function closeModal() {
    searchController?.abort();
    searchVersion++;
    clearTimeout(debounceTimer);
    modal?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (input) input.value = '';
    showState('empty');
    if (resultsContainer) resultsContainer.innerHTML = '';

    // Remove focus trap listener
    document.removeEventListener('keydown', handleFocusTrap);

    // Restore focus to the element that opened the modal
    if (previousActiveElement && previousActiveElement.focus) {
      previousActiveElement.focus();
    }
  }

  function showState(state: 'empty' | 'loading' | 'no-results' | 'results') {
    emptyState?.classList.toggle('hidden', state !== 'empty');
    loadingState?.classList.toggle('hidden', state !== 'loading');
    loadingState?.setAttribute('aria-hidden', state === 'loading' ? 'false' : 'true');
    noResultsState?.classList.toggle('hidden', state !== 'no-results');
  }

  async function performSearch(query: string) {
    searchController?.abort();
    const version = ++searchVersion;
    if (resultsContainer) resultsContainer.innerHTML = '';
    if (query.trim().length < 2) {
      showState('empty');
      announce('');
      return;
    }
    searchController = new AbortController();
    showState('loading');
    announce(currentLang === 'es' ? 'Buscando...' : 'Searching...');
    try {
      let products;
      if (/^https?:\/\//i.test(query.trim())) {
        const response = await fetch('/api/feed/product-by-link', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: query.trim(), lang: currentLang }), signal: searchController.signal,
        });
        const data = await response.json();
        if (!response.ok || !data.success || !data.product) throw new Error(catalogUnavailableMessage(currentLang));
        products = [data.product];
      } else {
        const params = new URLSearchParams({ q: query.trim(), lang: currentLang, region: 'US' });
        const response = await fetch(`/api/search?${params}`, { signal: searchController.signal });
        products = (await readCatalogResponse(response, currentLang)).products;
      }
      if (version !== searchVersion) return;
      if (!products.length) {
        const message = currentLang === 'es' ? 'No se encontraron resultados' : 'No results found';
        if (noResultsState) noResultsState.textContent = message;
        showState('no-results');
        announce(message);
        return;
      }
      showState('results');
      announce(currentLang === 'es' ? `${products.length} resultados` : `${products.length} results`);
      renderResults(products);
    } catch (error) {
      if (version !== searchVersion || (error instanceof Error && error.name === 'AbortError')) return;
      const message = catalogUnavailableMessage(currentLang);
      if (noResultsState) noResultsState.textContent = message;
      showState('no-results');
      announce(message);
    }
  }

  function renderResults(products: any[]) {
    if (!resultsContainer) return;
    const addToCartText = currentLang === 'es' ? 'Agregar' : 'Add';
    resultsContainer.innerHTML = products.map(item => {
      const title = escapeHtml(item.title);
      const brand = escapeHtml(item.brand);
      const asin = escapeHtml(item.asin);
      const image = escapeHtml(safeCatalogUrl(item.image || item.featuredImage?.url));
      const url = escapeHtml(safeCatalogUrl(item.affiliateUrl));
      const price = escapeHtml(formatCatalogPrice(item.price, item.currency, currentLang));
      const rawPrice = typeof item.price === 'number' && Number.isFinite(item.price) ? item.price : '';
      return `
        <div class="search-result-item" role="listitem">
          <a ${url ? `href="${url}"` : 'aria-disabled="true"'} target="_blank" rel="noopener noreferrer nofollow sponsored" class="search-result-link" aria-label="${brand} ${title}, ${price}">
            ${image ? `<img src="${image}" alt="" class="search-result-image" loading="lazy" aria-hidden="true" />` : '<div class="search-result-image" aria-hidden="true"></div>'}
            <div class="search-result-content">
              <span class="search-result-brand">${brand}</span>
              <h4 class="search-result-title">${title}</h4>
            </div>
            <span class="search-result-price" aria-hidden="true">${price}</span>
          </a>
          <button type="button" class="search-result-cart-btn" ${url ? '' : 'disabled'} data-asin="${asin}" data-product-id="${asin}"
            data-title="${title}" data-brand="${brand}" data-image="${image}" data-price="${rawPrice}"
            data-currency="${escapeHtml(item.currency)}" data-affiliate-url="${url}" data-fetched-at="${escapeHtml(item.fetchedAt)}"
            aria-label="${addToCartText}" title="${addToCartText}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <span class="cart-plus">+</span>
          </button>
          ${priceDetailsHtml(currentLang, item.fetchedAt)}
        </div>`;
    }).join('');
    resultsContainer.querySelectorAll('.search-result-cart-btn').forEach(btn => {
      btn.addEventListener('click', (event) => {
        event.stopPropagation();
        handleAddToCart(btn as HTMLButtonElement);
      });
    });
  }

  // Handle add to cart from search results
  function handleAddToCart(btn: HTMLButtonElement) {
    if (!(window as any).cart?.add) {
      console.warn('Cart API not available');
      return;
    }

    const parsedPrice = parseFloat(btn.dataset.price || '');
    const product = {
      asin: btn.dataset.asin || '',
      productId: btn.dataset.productId || '',
      title: btn.dataset.title || '',
      brand: btn.dataset.brand || '',
      image: btn.dataset.image || '',
      price: Number.isFinite(parsedPrice) ? parsedPrice : '',
      currency: btn.dataset.currency || '',
      affiliateUrl: btn.dataset.affiliateUrl || '',
      fetchedAt: btn.dataset.fetchedAt || '',
      marketplace: 'amazon.com',
    };

    (window as any).cart.add(product);

    // Visual feedback
    btn.classList.add('added');
    setTimeout(() => btn.classList.remove('added'), 1500);
  }

  // Event listeners
  triggerDesktop?.addEventListener('click', openModal);
  triggerMobile?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);

  modal?.querySelector('.search-backdrop')?.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.getAttribute('aria-hidden') === 'false') {
      closeModal();
    }
    // Cmd/Ctrl + K to open search
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openModal();
    }
  });

  let debounceTimer: ReturnType<typeof setTimeout>;
  input?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value;
    searchController?.abort();
    searchVersion++;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => performSearch(query), 350);
  });

  // Handle navigation from search results
  resultsContainer?.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest('a');
    if (link) {
      closeModal();
    }
  });

</script>
